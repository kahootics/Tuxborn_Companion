---
import Head from "../components/Head.astro";
import startupScriptsInliner from "../scripts/startup/startup-scripts.ts";
import type {ScriptName} from "../scripts/startup/startup-scripts.ts";

interface Props {
    pageFullUrl: string, 
    description: string, 
    title: string,
	startupScripts?: ScriptName[],
	imageUrl?: string, 
	imageType?: string, 
	imageWidth?: string, 
	imageHeight?: string
}

const { pageFullUrl, description, title, startupScripts, 
		imageUrl, imageType, imageWidth, imageHeight
 } = Astro.props;
---



<Head pageTitle={title}
	  metaTitle=`Tuxborn ${title}`
	  author="kahootics" 
	  imageUrl={imageUrl ?? "https://raw.githubusercontent.com/Omni-guides/Tuxborn/refs/heads/main/images/Splash.png"}
	  iconUrl='/Tuxborn_Companion/helmet.svg'
	  iconType='image/svg+xml'
	  imageType={imageType ?? "image/png"}
	  imageWidth={imageWidth ?? "1280"}
	  imageHeight={imageHeight ?? "720"}
	  {description}
   	  locale="en_us"
   	  siteName="Tuxborn Companion" 
   	  siteType="website"
   	  {pageFullUrl}>
	{startupScripts && 
		<script is:inline set:html={startupScriptsInliner(...startupScripts)}></script>}
	<slot />

</Head>