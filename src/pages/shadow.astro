---



import csvUnpack from '../scripts/data-management/csv-unpack';
import { validateTypeMod, modMiniMap } from '../scripts/data-management/validate-type-mods';
import '../scripts/data-management/write-static-as-json.ts'
import companionDatasheets from '../data/companion-datasheets.json';

const records = await csvUnpack(companionDatasheets.modsCompendium.id, companionDatasheets.modsCompendium.gid);

const filteredRecords = records.filter((record) => record.enabled === true);

const validatedRecords = filteredRecords.map(validateTypeMod);

const minifiedRecords = filteredRecords.map(modMiniMap);

const sortlist = ['id', 'name', 'category', 'creator', 'length', 'level'];

---

<html lang="en">
	<head>
		<title>Testing Area | Tuxborn Companion</title>
		<link rel="icon" type="image/svg+xml" href="/Tuxborn_Companion/wuurf.svg" />
		<meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />

        <style>
            * {
                max-width: 100%;
            }
            :root, body {
                box-sizing: border-box;
                width: 100%;
                padding: 30px 15px;
            }
            #bottom {
                cursor: pointer;
            }
            div[id] {
                margin: 2rem auto;
            }
        </style>
    </head>
    <body>
        
            <div id="bottom">I DONT CARE GO TO BOTTOM</div>
            <script>
                document.getElementById('bottom')?.addEventListener('click', () =>{
                    window.scroll({top: document.documentElement.scrollHeight});
                })
            </script>

            
        <div id="target" >
            {validatedRecords.map( piece => {
               return  <div id={piece.id}>
                <div>ID: {piece.id}</div>
               <div>Name: {piece.name.full}</div>
               <div>Creator: {piece.creator}</div>
               <div>Category: {piece.category}</div>
               <div>Length: {piece.length}</div>
               <div>Level: {piece.req.level}</div>
               {/* JSON.stringify(piece) */}
               <div>Overview: {piece.overview}</div>
               <div>Notes: {piece.notes.text}</div>
               </div>
            })
            }
        </div>
        <div><i style="white-space: pre;"></i></div>
        <button type="button"> clicllalcdhhs</button>
        <select name="sortlist">
            {sortlist.map(sortite => 
                <option value={sortite}>{sortite}</option>
            )}
        </select>
        <label for="ascend">Ascending?
            <input type="checkbox" value="ascending" checked id="ascend">
        </label>

        <script>
            const counter = document.querySelector('i');
            const sele = document.querySelector('select');
            const asc = document.querySelector('input#ascend') as HTMLInputElement;
            let start = 0;
            let end = 0;
            const writePerformance= () => {
                end = performance.now();
                counter ? counter.textContent +=  `Time: ${(end - start).toFixed(3)} ms`:
            console.log(`Time: ${(end - start).toFixed(3)} ms`);
            start = performance.now();
            }
            const target = document.getElementById('target');

            start = performance.now();

            /* Testing setup speed */
            import type { MiniMod } from '../scripts/data-management/validate-type-mods';
            const response = await fetch(`/Tuxborn_Companion/data/mods-mini-compendium.json?nocache=${crypto.randomUUID()}`);
            if(!response.ok) throw new Error('Fetch failded: ' + response.status);
            const result = await response.json();
            /* if(target) { target.textContent += JSON.stringify(result, null, 2)} */
            const mapping: Map<string, MiniMod> = new Map(result);
            for (const [key, value] of mapping) {
                mapping.set(key, { ...value, element: document.getElementById(key) });
            }
            /* Map of all mods created */


                        
            
            
writePerformance();

            /* build array to keep track of layout state (starts from default) */
            const modsView: any[] = [];
            for (const [key, value] of mapping) {
                modsView.push({
                        element: value.element,
                        id: key,
                        name: value.name.full,
                        category: value.category,
                        creator: value.creator,
                        length: value.length,
                        level: value.req.level
                    })
            }

            writePerformance();

            /* don't sort if order is the same */
            let lastSorted = 'id';
            let lastAsc = true;
            let sortLock = false;

            /* Testing Sorting speed */
            sele && asc ? document.querySelector('button')?.addEventListener('click',() => {
                start = performance.now();
                const sortitem = sele.value;
                const ascending = asc.checked;

                if((sortitem === lastSorted && ascending === lastAsc) || sortLock) return;


                sortLock = true;
                switch(typeof modsView[0][sortitem]) {
                    case 'string': {
                        ascending
                        ? modsView.sort((a, b) => a[sortitem].localeCompare(b[sortitem], undefined, { sensitivity: 'base' }))
                        : modsView.sort((b, a) => a[sortitem].localeCompare(b[sortitem], undefined, { sensitivity: 'base' }));
                        break;
                    }
                    case 'number': {
                        ascending
                        ? modsView.sort((a, b) => a[sortitem] - b[sortitem] )
                        : modsView.sort((b, a) => a[sortitem] - b[sortitem] );
                        break;
                    }
                    default: break;
                }
                
                
                lastSorted = sortitem;
                lastAsc = ascending;
                

            const newView = document.createDocumentFragment();
            modsView.forEach(mod => {
                newView.appendChild(mod.element);
            });
            if(target && counter) {
                target.append(newView);
                sortLock = false;
                counter.textContent += `\n|||||||Sort done: ${lastSorted}; ${lastAsc ? 'ascending' : 'descending'}|||||||`;
            } 

            writePerformance();
            }): null;
            
        </script>
    </body>
</html>