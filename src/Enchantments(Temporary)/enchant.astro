---

import {z} from 'zod';
import {enchantArmorTest, magEffTest} from './types';
import ClippedArticle from '../layouts/wrappers-containers/clipped-article.astro';
import Magnitude from './magnitude.astro';
import { calcEnchantPrice, calcEnchantPriceSkillMult } from './enchantments';
import Restrictions from './restrictions.astro';
import HowToLearn from './howToLearn.astro';
import './common.css';
import EnchEffect from './enchEffect.astro';
import EnchFilter from './EnchFilter.astro';
import EnchValue from './enchValue.astro';
import EnchCharges from './enchCharges.astro';

interface Props {
    enchant: z.infer<typeof enchantArmorTest>,
    effects: Map<String,z.infer<typeof magEffTest>>,
    default_order: number
}
const { enchant, effects, default_order } = Astro.props;


---

<ClippedArticle name='mod-article' 
    id={enchant.id} 
    data-default={default_order}
    data-ench-eff-list={`${enchant.name}|${enchant.effects.map(effect => {
        const temp = effects.get(effect);
        if(!temp) throw new Error(`${effect} is missing from list`);
        return temp.types.join('|')
    }).join('|')}`}
    data-tier={'SABCDEF'.indexOf(enchant.tier ?? 'F')}
    data-name={enchant.name}
    data-mod={enchant.mod}
    data-restrictions={enchant.restrictions?.join('|')}
    data-value={enchant.priceAtZero}
    > 
    <button class="dropdown no-style-button" aria-controls={`${enchant.id}-drop`}>
    <header class="mod-section">
        <div><h2 aria-describedby={`${enchant.id}-desc`}>{enchant.name}</h2>
            <strong class="enchantment-tier">{enchant.tier}</strong>
        </div>
        <span>{enchant.recordType === 'ARMO' ? "👚": "🪓"}{enchant.bugs && <b>⚠️ </b>}<i>({enchant.mod})</i></span>
    </header>
    <section class="mod-section description">
        <p id={`${enchant.id}-desc`}>
            {enchant.effects.map(effect => {
                const temp = effects.get(effect);
                if(!temp) throw new Error(`${effect} is missing from list`);
                if(temp.recordType !== enchant.recordType) throw new Error(`Mismatching record types for ${
        enchant.id} and effect ${temp.name}`);

                const tempFrags = `${temp.description.og}. `.split('<mag>');
                return tempFrags.map((frag,i) => {
                    if(i===0) {
                        return frag
                    } else {
                        return <Magnitude effectId={temp.id} enchantmentId={enchant.id}
                        recordType={temp.recordType} mag={temp.mag}>{frag}</Magnitude>
                    }
                });
            }
            )}
        </p>
    </section>
    </button>
    <div class="dropped" id={`${enchant.id}-drop`}>

        <section class="mod-section same-lined">
            <EnchValue 
                enchantId={enchant.id}
                enchantingLevel={100}
                recordType={enchant.recordType}
                enchValueAtZero={enchant.priceAtZero}
                enchChargesAtHundred={enchant.chargesAtHundred}
            />
        </section>

        {enchant.recordType === 'WEAP' && <section class="mod-section same-lined ench-charges-section" hidden>
            <EnchCharges
                enchantId={enchant.id}
                enchantingLevel={100}
                recordType={enchant.recordType}
                enchChargesAtHundred={enchant.chargesAtHundred}
            />
        </section>}

        <section class="mod-section closer">
            <Restrictions 
                restrictionList={enchant.restrictions} 
                recordType={enchant.recordType} />
        </section>

        <section class="mod-section closer">
            <EnchEffect 
                recordType={enchant.recordType}
                enchantmentId={enchant.id}
                effectsList={effects}
                enchEffects={enchant.effects}
             />
        </section>
        {enchant.disenchant && <section class="mod-section closer">
            <HowToLearn 
                disenchantList={enchant.disenchant}
                recordType={enchant.recordType}
                obtainMethod={enchant.obtain} />
        </section>}
        {enchant.notes && <section class="mod-section closer">
            <h3>Notes</h3>
            <p>{enchant.notes}</p>
        </section>}
        {enchant.bugs && <section class="mod-section closer">
            <h3>Bugs ⚠️</h3>
            <p>{enchant.bugs}</p>
        </section>}
    </div>
    
</ClippedArticle>

<script src="./filter.ts"></script>
