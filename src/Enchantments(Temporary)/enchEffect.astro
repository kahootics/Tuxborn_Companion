---
import type { z } from 'astro/zod';
import type { magEffTest, RecordType } from './types';
import Magnitude from './magnitude.astro';

interface Props {
    enchantmentId: string,
    effectsList: Map<String,z.infer<typeof magEffTest>>,
    enchEffects: string[],
    recordType: z.infer<typeof RecordType>
}
const { enchantmentId, effectsList, enchEffects, recordType } = Astro.props;


---

<h3>Effects</h3>
{ enchEffects.map(effect => {
    
    const eff = effectsList.get(effect);
    // Verification
    if(!eff) throw new Error(`${effect} is missing from list`);
    if(eff.recordType !== recordType) throw new Error(`Mismatching record types for ${
        enchantmentId} and effect ${eff.name}`);
    
    const tempFrags = `${eff.description.main ?? eff.description.og}.`.split('<mag>');
    
    return  <section class="clip-shape octagone mod-section">
            <h4>{eff.name.main ?? eff.name.og}</h4>
            {eff.recordType === 'WEAP' && 
            <div class="weap-ench-stats smaller closer">
                <section class="same-lined">
                    <h5>Damage<span class="hide-on-small-screens"> Type</span>: </h5>
                    <p class="smaller stat">{eff.kwda?.replace('Magic Damage','').trim()}</p>
                </section>
                <section class="same-lined">
                    <h5>Resist<span class="hide-on-small-screens"> Value</span>: </h5>
                    <p class="smaller stat">{eff.resist?.replace('Resist','').trim()}</p>
                </section>
            </div>
            }
            <p class="smaller">{tempFrags.map((frag,i) => {
                if(i===0) {
                    return frag
                } else {
                    return <Magnitude 
                        {enchantmentId}
                        effectId={eff.id}
                        recordType={eff.recordType} 
                        mag={eff.mag}>{frag}</Magnitude>
                }
            })}</p>
        </section>
                })
            }


<style>

h4 {
    text-shadow: 1px 1px 0.1em rgb(61, 55, 0);
    border-bottom: var(--tx-line-width-xxs) solid var(--tx-color-line);
}
h4 + * {
    margin-top: 0.2em;
}

.weap-ench-stats {
    display: flex;
    gap: 0.4em;
    max-width: fit-content;
    flex-wrap: wrap;
    border-bottom: var(--tx-line-width-xxs) solid var(--tx-color-line);
}
.weap-ench-stats section {
    align-items: baseline;
}
.weap-ench-stats h5 {
    padding: 0;
    margin: 0;
}
.stat {
    color: rgb(235, 255, 206);
}
</style>