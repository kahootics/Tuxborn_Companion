---
import type { z } from "astro/zod";
import { WeapCharges } from "./enchantments";
import type { RecordType } from "./types";

interface Props {
    enchantId: string,
    enchantingLevel: number,
    recordType: z.infer<typeof RecordType>,
    enchChargesAtHundred: number
}

const { enchantId, enchantingLevel, recordType, enchChargesAtHundred } = Astro.props;

---

<h3>Charges</h3>
<p> <strong id={`${enchantId}-charges`} 
        class=`${recordType.toLocaleLowerCase()}-enchantment-${enchChargesAtHundred > 0 ? 'charges' : 'charge'}` 
        data-charges-hundred={enchChargesAtHundred}
        >
        {enchChargesAtHundred > 0 
        ? WeapCharges.calc(enchantingLevel,enchChargesAtHundred)
        : (enchChargesAtHundred === -1 
            ? '∞'
            : 'not needed')}</strong>{enchChargesAtHundred === 0 ? "" : "⚡"}
</p>