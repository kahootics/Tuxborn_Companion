---
import SocialCard from "./sub-components/social-card.astro"

import ouro from '../data/social/ouro.json';
import omni from '../data/social/omni.json';
import anna from '../data/social/anna.json';
import tsp from '../data/social/tsp.json';

---

<section>
    <h2>Tuxborn Team</h2>
    <div>
        <SocialCard name={ouro.name} description={ouro.description} avatarImg={ouro.avatar} socials={ouro.socials}/>
        <SocialCard name={omni.name} description={omni.description} avatarImg={omni.avatar} socials={omni.socials}/>
        <SocialCard name={anna.name} description={anna.description} avatarImg={anna.avatar} socials={anna.socials}/>
        <SocialCard name={tsp.name} description={tsp.description} avatarImg={tsp.avatar} socials={tsp.socials}/>
    </div>
</section>

<style>
section {
    display: flex;
    flex-direction: column;
    align-items: center;
}
section > div {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
}
</style>