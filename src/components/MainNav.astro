---

import { undefined } from 'astro:schema';
import CompanionPanel from '../layouts/CompanionPanel.astro';
import WikiList from '../scripts/data-management/wiki/WikiList.astro';
import '../styles/companion-main-navigation.css'
import DropdownControl from "./navigation/dropdown-control.astro";
import Settings from './Settings.astro';


const pages = [
    {
        name: 'Mods Compendium',
        url: "/Tuxborn_Companion/Mods_Compendium/"
    }, {
        name: 'Mods in Beta',
        url: "/Tuxborn_Companion/Beta_Mods/"
    }, {
        name: 'Hammet\'s Dungeons in Beta',
        url: "/Tuxborn_Companion/Beta_Hammets_Dungeons/"
    }, {
        name: 'Enchantments in Beta',
        url: "/Tuxborn_Companion/Beta_Enchantments/"
    }      
];

---

<CompanionPanel 
    id="main-nav"
    panel='left' 
    name="Main Menu"
    backButton='true'
>
    <div id="main-nav-controls" >
        <DropdownControl name="Wiki" controlledId="wiki-nav">Wiki</DropdownControl>
        <DropdownControl name="Companion" controlledId="companion-nav">Companion</DropdownControl>
        <DropdownControl name="Support" controlledId="support-nav">Support</DropdownControl>
        <DropdownControl name="Settings" controlledId="settings-nav">Settings</DropdownControl>
    </div>

    <nav id="wiki-nav" hidden data-shown="false" class="main-menu-nav-section flip-commander">
        <WikiList />
    </nav>

    <nav id="companion-nav" hidden data-shown="false" class="main-menu-nav-section flip-commander" >
        <ul class="flip-scene">
            {pages.map((page) => 
            <li class="flip-target flip-backwards clip-frame octagone ">
                <a class="item-dropdown" href={page.url} aria-current={Astro.url.href.includes(page.url) ? "page" : null} >
                    {page.name}
                </a>
                {Astro.url.href.includes(page.url) ? <div aria-hidden="true" class="aria-current-page"></div> : null}
                
            </li>
            )}
        </ul>
    </nav>

    <nav id="support-nav" hidden data-shown="false" class="main-menu-nav-section flip-commander">
        <ul class="flip-scene">
            <li class="flip-target flip-backwards clip-frame octagone item-dropdown"><a class="item-dropdown" href="https://discord.gg/xRrHRsb5e9" target="_blank">Discord</a></li>
            <li class="flip-target flip-backwards clip-frame octagone item-dropdown"><a class="item-dropdown" href="https://github.com/Omni-guides/Tuxborn/blob/main/Changelog.md" target="_blank">Changelog</a></li>
        </ul>
    </nav>

    <div id="settings-nav" hidden data-shown="false" class="main-menu-nav-section flip-commander">
        <Settings /> 
    </div>

    <script src="../scripts/main-navigation.ts"></script>
</CompanionPanel>
