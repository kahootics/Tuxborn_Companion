---
interface pageImage {
    url: string,
    type?: string,
    width?: string | number,
    height?: string | number
}
interface Props {
    pageTitle: string,
    pageAuthor: string,
    pageImage: pageImage,
    description: string,
    locale: string,
    siteName?: string,
    type?: string,
    pageFullUrl: string,
    appleTouchIconUrl?: string,
    manifestUrl?: string,
    sitemapUrl?: string
}

const { pageTitle, pageAuthor, pageImage, description, locale, siteName, type, pageFullUrl, appleTouchIconUrl, manifestUrl, sitemapUrl } = Astro.props;
---

{/*  Generic tags  */}
<meta name="author" content={pageAuthor} />
<meta name="description" content={description} />

{/*  Open Graph tags  */}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale} />
<meta property="og:url" content={pageFullUrl} />
{siteName &&
<meta property="og:site_name" content={siteName} />}
{type &&
<meta property="og:type" content={type} />}
{pageImage && 
<meta property="og:image" content={pageImage.url} />}
{pageImage?.type &&
<meta property="og:image:type" content={pageImage.type} />}
{(pageImage?.width && pageImage?.height) &&
<meta property="og:image:width" content={`${pageImage.width}`} />
<meta property="og:image:height" content={`${pageImage.height}`} />}

{/*  Twitter Card tags  */}
<meta name="twitter:creator" content={pageAuthor} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
{siteName && 
<meta name="twitter:site" content={siteName} />}
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={pageImage.url} />

{/*  Apple Touch Icon  */}
{appleTouchIconUrl &&
<link rel="apple-touch-icon" href={appleTouchIconUrl} />}

{/*  WEB Manifest  */}
{manifestUrl &&
<link rel="manifest" href={manifestUrl} />}

{/*  Sitemap */}
{sitemapUrl && 
<link rel="sitemap" href={sitemapUrl} />}

{/*  Page URL  */}
<link rel="canonical" href={pageFullUrl} />
