---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import extractImageFromName from '../../scripts/utilities/extract-image-from-name';
import ModalTrigger from '../utility/modal-trigger.astro';
import { toSafeKebab } from '../../scripts/utilities/string-parsers';

interface Props {
    image: {
        int: string | null,
        ext: string
    }
    alt: string
}

const { image, alt } = Astro.props;

let src: ImageMetadata | undefined;
let altImage = '';

if(image.int) {
    src = await extractImageFromName(image.int)
} else {
    altImage = image.ext;
}

---

<div class="mod-image-wrapper clip-shape octagone clip-as-border">
    <ModalTrigger id={toSafeKebab(alt)} modalId='image-modal' data-ext-src={image.ext} classList={['mod-image-container', 'clip-shape', 'octagone']}>
        {src ? (
            <Image
                src={src}
                alt={alt}
                widths={[240, 540, 720, src.width]}
                sizes={`(max-width: 360px) 240px,
                    (max-width: 720px) 540px,
                    (max-width: 1080px) 720px,
                    ${src.width}px`}
            />
        ) : (
            <Image src={altImage} alt={alt} width={1080} height={720}/>
        )}        
    </ModalTrigger>
</div>

