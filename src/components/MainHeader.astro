---

import '../styles/companion-header.css';
import Helmet from '../assets/svg/helmet.astro';

const omni = 'https://github.com/Omni-guides/Tuxborn';


---

<header id="main-header" class="clip-frame inset-bottom">
    

     <div id="main-header-container">
	{/*	<div id="readme" class="clip-shape octagone">
			<a id="readme-link" href={ omni + "#" } target="_blank" class="clip-shape octagone">
				<Helmet /><span class="hide-on-small-screens">Readme</span>
			</a>
    	</div> */}
		<Helmet />
    <button type="button" id="tx-filters-section-toggle" aria-expanded="false" aria-controls="tx-filters-section">
        Filters
    </button>
    
        <button id="wiki-links" type="button" aria-expanded="false" aria-controls="wiki-links-section">
            Wiki
        </button>
        
    
    <a href="https://docs.google.com/spreadsheets/d/1HzoB06GWpWGvLCa3qLuvxmsM4Q5IZp-GYvYIKLLCM1A/edit?gid=1883312431#gid=1883312431">
        Spreadsheet
    </a>
    
    </div>



</header>

<style>
	#readme, #readme:is(:hover, :active, :focus) {
		display: block;
		height: 80%;
		border-radius: var(--tx-border-radius-soft);
		padding: var(--tx-line-width-xs);
		background-color: var(--tx-color-line);
		--tx-clip: 3px;
	}
	#readme-link {
		display: block;
		color: var(--tx-color-text);
		text-decoration: none;
		--background: var(--tx-color-two-background);
		padding: var(--tx-line-width-xxs);
		height: 100%;
		background-color: var(--background);
		border-radius: inherit;
		display: flex;
		align-items: center;
	}
	#readme-link:hover {
		--background: var(--tx-color-two-background-strong);
	}
	#readme-link:is(:active, :focus) {
		--background: var(--tx-color-two-background-accent);
	}
	#readme span {
		display: inline-block;	
    	padding: var(--tx-padding-s);
	}
	#readme svg {
		height: 100%;
		aspect-ratio: 1;
	}
</style>