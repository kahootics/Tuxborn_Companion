---
interface Props {
    social: string,
    link: string
}
const { social, link } = Astro.props;
---

<li class="clip-shape octagone">
    <address>
        <a href={link} target="_blank" >{social}</a>
    </address>
    
</li>

<style>

li {
    padding: var(--tx-padding-xs);
    background-color: var(--tx-color-two-background-alpha);
}
</style>