---

interface Props {
    name: string,
    avatarImg: string,
    description: string,
    socials: { [key: string]: string }
}
const { name, avatarImg, description, socials } = Astro.props;

import { Image } from 'astro:assets';
import SocialListItem from './social-list-item.astro';

const socialList = Object.entries(socials);

if(!socialList ) throw new Error('Social card empty!')
---

<article class="social-card clip-shape octagone">
    <div class="clip-shape octagone">
        <h3 class="social-name clip-shape octagone">{name}</h3>
        <figure class="social-avatar clip-shape octagone">
            <Image class="clip-shape octagone" src={avatarImg} alt={`${name}'s socials'`} width=400 height=400 />
            <figcaption class="hide-from-view">{name}</figcaption>
        </figure>

        <p class="social-description clip-shape octagone">{description}</p>
        <nav class="social-profiles" aria-label={`${name}'s social profiles'`}>
            <ul>
                {socialList.map((socialItem)=> 
                    <SocialListItem social={socialItem[0]} link={socialItem[1]} />
                )}
            </ul>
        </nav>
    </div>
    
</article>

<script>
    
</script>

<style>

.social-card {
    --tx-clip: 5px;
    width: fit-content;
    background-color: var(--tx-color-line);
    padding: var(--tx-line-width-xs);
}
div {
    background-color: var(--tx-color-two-background);
    padding: var(--tx-padding-s);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--tx-spacing-s);
    grid-template-areas:
        'im h'
        'im nav'
        'im desc';

}
div > * {
    --tx-clip: 3px;
}
.social-avatar {
    grid-area: im;
    background-color: var(--tx-color-one-background-alpha);
    padding: var(--tx-padding-xs);
    display: flex;
    align-items: center;
    justify-content: center;
}
.social-name {
    grid-area: h;
    background-color: var(--tx-color-two-background-strong-alpha);
    padding: var(--tx-padding-xs);
    text-decoration: underline;
    margin: 0;
}
.social-description {
    grid-area: desc;
    padding: var(--tx-padding-xs);
    background-color: var(--tx-color-two-background-alpha);
}
.social-avatar > img {
    max-width: 5rem;
}
.social-profiles {
    grid-area: nav;
    padding: var(--tx-padding-xs);
    padding-left: 0;
    
}
.social-profiles > ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tx-spacing-s);
}
.social-profiles > ul > li {
    padding: var(--tx-padding-xs);
}
</style>